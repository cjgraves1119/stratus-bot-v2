#!/bin/sh
# pre-push guardrail for the PUBLIC personal fork (cjgraves1119/stratus-bot-v2).
# Enforces the two rules that have actually been violated historically:
#   1. SECRET SCAN on every commit being pushed (2026-06-10: a path-scoped scan
#      let a live TD SYNNEX credential reach the public repo).
#   2. INTERNAL-DOC BLOCKLIST: HANDOFF-*/PLAN-*/EMAIL-*.md never leave the
#      machine (2026-07-15: a customer-named RCA doc rode into a branch via a
#      merge and had to be filter-branched out pre-push).
# Install once per clone: git config core.hooksPath scripts/githooks
# (worktrees inherit it). Bypass for a false positive: git push --no-verify,
# then fix the pattern here.

SECRET_RE='Basic [A-Za-z0-9+/=]{20,}|sk-ant-[a-zA-Z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|1000\.[a-f0-9]{32}|-----BEGIN[ A-Z]*PRIVATE KEY'
# Known-benign: index.js strips this literal out of pasted text.
BENIGN_RE='replace\(/-----BEGIN PRIVATE KEY'
DOC_RE='^(HANDOFF|PLAN|EMAIL)-.*\.md$'

fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleted ref → nothing to scan.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  # Commits new to the remote (new branch → everything not already on origin).
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *)      range="$local_sha --not --remotes=origin" ;;
  esac
  for c in $(git rev-list $range | head -500); do
    # 1) secret scan of this commit's full tree
     hits=$(git grep -nIE "$SECRET_RE" "$c" -- . ":(exclude)scripts/githooks/pre-push" | grep -vE "$BENIGN_RE")
    if [ -n "$hits" ]; then
      echo "pre-push BLOCK: secret-pattern hit in commit $c:" >&2
      echo "$hits" | head -5 >&2
      fail=1
    fi
    # 2) internal docs anywhere in this commit's tree
    docs=$(git ls-tree -r --name-only "$c" | grep -E "$DOC_RE")
    if [ -n "$docs" ]; then
      echo "pre-push BLOCK: internal doc(s) in commit $c (strip from history before pushing):" >&2
      echo "$docs" | head -5 >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo "Push refused. If a hit is a false positive, adjust scripts/githooks/pre-push; do NOT bypass for real secrets — rotate them instead (deletion != un-leak)." >&2
  exit 1
fi
exit 0
