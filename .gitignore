# Dependencies and build output
node_modules/
dist/
harness-dist/
coverage/
release/
.release-stage/
.wrangler/
.wrangler-dry-run*/

# Local secrets — never commit. Wrangler secrets live in Cloudflare.
.dev.vars
.dev.vars.*
.env
.env.*
env/
*.pem
*.key

# Point-in-time snapshot directories and file-level backups. These are local
# safety nets, not history; git is the history now.
*-backup-*/
*.backup-*
*.bak
*.keep
*.pre-*-snapshot
src/index.js.backup-*
backup/
backups/
*.backup
*.orig

# Scratch
.tmp-*
.DS_Store
graphify-out/
*.crx
*.zip

# Local deployment provenance. The sanctioned DEV deploy appends this audit
# trail after a clean-tree gate; keeping it local prevents the next deploy from
# refusing its own prior log as an untracked repository change.
/deploys.log
